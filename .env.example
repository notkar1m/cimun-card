# Postgres connection string used at request time. Point this at a pooled
# connection (e.g. Neon's PgBouncer endpoint) in production.
DATABASE_URL="postgresql://user:password@localhost:5432/cimun_card?schema=public"

# Unpooled connection, used only when running migrations (prisma migrate
# deploy). Same value as DATABASE_URL unless you're using a pooled provider.
DIRECT_URL="postgresql://user:password@localhost:5432/cimun_card?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# SMTP (e.g. Gmail: use an app password, not your normal password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-app@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Cimun Card <your-app@gmail.com>"

# Public URL of the app (used to build links in emails, e.g. password reset)
APP_URL="http://localhost:4000"

# Initial superadmin, used by prisma/seed.ts
SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="change-me-immediately"
