{
  "name": "cimun-card",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend && npm run copy-frontend --workspace backend",
    "start": "npm run prisma:migrate:deploy && npm run start --workspace backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "seed": "npm run seed --workspace backend"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
